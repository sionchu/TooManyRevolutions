{
  "name": "fantasy-state-simulator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run --exclude src/sim/inspection/f01LongRunHeadlessInspection.test.ts --exclude src/sim/inspection/f02MultiSeedOutcomeSurveyInspection.test.ts --exclude src/sim/inspection/f03InterventionCounterfactualInspection.test.ts --exclude src/sim/inspection/f03bAgencyLeverageDiagnosisInspection.test.ts --exclude src/sim/inspection/f04DegenerateStrategyExploitCheckInspection.test.ts --exclude src/sim/inspection/f04dInstitutionActionCounterfactualsInspection.test.ts",
    "inspect:t015": "vitest run src/sim/inspection/t015DiffusionInspection.test.ts --reporter=verbose --silent=false",
    "inspect:t015b": "vitest run src/sim/inspection/t015bDiffusionStabilization.test.ts --reporter=verbose --silent=false",
    "inspect:t015c": "vitest run src/sim/inspection/t015cPoliticalTimeScale.test.ts --reporter=verbose --silent=false",
    "inspect:t016b": "vitest run src/sim/inspection/t016bInterventionCapacityInspection.test.ts --reporter=verbose --silent=false",
    "inspect:t017": "vitest run src/sim/inspection/t017InstabilityInspection.test.ts --reporter=verbose --silent=false",
    "inspect:t017a": "vitest run src/sim/inspection/t017aTerritorialTopologyInspection.test.ts --reporter=verbose --silent=false",
    "inspect:t017b": "vitest run src/sim/inspection/t017bTerritorialAuthorityMigrationInspection.test.ts --reporter=verbose --silent=false",
    "inspect:t018": "vitest run src/sim/inspection/t018PoliticalCrisisInspection.test.ts --reporter=verbose --silent=false",
    "inspect:t019": "vitest run src/sim/inspection/t019DiplomacyInspection.test.ts --reporter=verbose --silent=false",
    "inspect:t020": "vitest run src/sim/inspection/t020ForeignIdeologicalThreatInspection.test.ts --reporter=verbose --silent=false",
    "inspect:t021": "vitest run src/sim/inspection/t021SimplifiedConflictInspection.test.ts --reporter=verbose --silent=false",
    "inspect:t022": "vitest run src/sim/inspection/t022OrderConsolidationInspection.test.ts --reporter=verbose --silent=false",
    "inspect:t023": "vitest run src/sim/inspection/t023StateDissolutionInspection.test.ts --reporter=verbose --silent=false",
    "inspect:t024": "vitest run src/sim/inspection/t024PersistenceReplayInspection.test.ts --reporter=verbose --silent=false",
    "inspect:f01": "vitest run src/sim/inspection/f01LongRunHeadlessInspection.test.ts --pool=forks --testTimeout=240000 --reporter=verbose --silent=false",
    "inspect:f02": "vitest run src/sim/inspection/f02MultiSeedOutcomeSurveyInspection.test.ts --pool=forks --testTimeout=600000 --reporter=verbose --silent=false",
    "inspect:f03": "vitest run src/sim/inspection/f03InterventionCounterfactualInspection.test.ts --pool=forks --testTimeout=240000 --reporter=verbose --silent=false",
    "inspect:f03b": "vitest run src/sim/inspection/f03bAgencyLeverageDiagnosisInspection.test.ts --pool=forks --testTimeout=240000 --reporter=verbose --silent=false",
    "inspect:f04": "vite-node src/sim/inspection/f04DegenerateStrategyExploitCheck.cli.ts",
    "inspect:f04a": "vite-node src/sim/inspection/f04aEndogenousFactionDynamics.cli.ts",
    "inspect:f04b": "vite-node src/sim/inspection/f04bActiveConflictRecoveryAgency.cli.ts",
    "inspect:f04d": "vitest run src/sim/inspection/f04dInstitutionActionCounterfactualsInspection.test.ts --pool=forks --testTimeout=30000 --reporter=verbose --silent=false",
    "inspect:v01": "vitest run src/presentation/v01PresentationInspection.test.ts --reporter=verbose --silent=false",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write ."
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.34.0",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.41.0",
    "vite": "^7.1.3",
    "vite-node": "^3.2.4",
    "vitest": "^3.2.4"
  }
}
